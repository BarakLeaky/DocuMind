# ---------- Clerk: accounts and sign-in (https://dashboard.clerk.com -> API keys) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Database: Postgres with pgvector (Neon is free and works as-is: https://neon.com) ----------
# Paste the connection string from the Neon console, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------- AI (the app works without these; they unlock the good parts) ----------
# Generated, cited answers in the AI console and automatic field extraction (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Meaning-based search (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Security ----------
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_SIGNING_SECRET=
# Protects /api/cron/ingest. Vercel sends it automatically when this variable is set.
CRON_SECRET=

# ---------- Limits ----------
# Vercel accepts request bodies up to 4.5 MB, so keep this at 4 when deploying there.
MAX_UPLOAD_MB=4
STORAGE_QUOTA_MB=500

# ---------- Sentry (optional) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
